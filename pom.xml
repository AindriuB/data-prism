  <properties>
    <!-- Artifacts target 21 even when built on a newer JDK, so the library
         stays usable on the version the specification names. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>4.1.1</spring-boot.version>
    <mcp.version>2.0.1</mcp.version>
    <archunit.version>1.5.1</archunit.version>
    <hazelcast.version>5.7.0</hazelcast.version>
    <nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
    <!-- Jackson 3 (tools.jackson). Spring Boot 4.1.1 manages 3.1.5, which is affected by
         GHSA-wv8q-qhhj-9h54, GHSA-cxp5-3px4-pw24, GHSA-q4xh-88c3-wmh7, GHSA-wjgm-6hv5-3cvf
         and GHSA-gx83-3vf8-gh7j (fixed in 3.1.6 and 3.1.7). Remove this property and the
         jackson-bom import once Boot manages 3.1.7 or later. -->
    <jackson3.version>3.1.8</jackson3.version>

    <!-- Maven 3.8.6 still defaults to compiler 3.1, which predates the `release`
         flag, and surefire 2.12.4, which cannot run JUnit 5 at all. Both are
         pinned rather than inherited. -->
    <enforcer.version>3.6.3</enforcer.version>
    <compiler.version>3.16.0</compiler.version>
    <surefire.version>3.6.0</surefire.version>

    <!-- Used only inside the `release` profile below: sources/javadoc jars,
         signing and the Central Portal publishing plugin. Never resolved by
         a plain `mvn verify`. -->
    <source-plugin.version>3.4.0</source-plugin.version>
    <javadoc-plugin.version>3.12.0</javadoc-plugin.version>
    <gpg-plugin.version>3.2.8</gpg-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
    <cyclonedx-plugin.version>2.9.3</cyclonedx-plugin.version>
    <pitest-plugin.version>1.30.0</pitest-plugin.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Declared before the Spring Boot BOM import so it wins: the imported BOM
           manages hazelcast at its own hazelcast.version (5.5.0 in Boot 4.1.x). -->
      <dependency>
        <groupId>com.hazelcast</groupId>
        <artifactId>hazelcast</artifactId>
        <version>${hazelcast.version}</version>
      </dependency>
      <!-- Imported ahead of the Spring Boot BOM so it wins over the 3.1.5 that BOM manages
           (see jackson3.version above). Same pattern as nimbus-jose-jwt below (D-139-C). -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson3.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Managed once, ahead of the Spring Boot BOM import so it wins: Spring Security 7.1.1
           brings 10.9.1, and the server (resource-server JWT verification) and the quickstart
           issuer (signing) must resolve the same library (D-139-C). -->
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-bom</artifactId>
        <version>${mcp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-annotations</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-pseudonymisation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-validation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-orchestration</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-connectors-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-hazelcast</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-reidentification</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
