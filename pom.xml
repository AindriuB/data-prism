<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.aindriub</groupId>
  <artifactId>data-prism</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>

  <name>Data Prism</name>
  <description>A privacy layer between MCP clients and enterprise APIs.</description>
  <url>https://github.com/AindriuB/data-prism</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <!-- No <email>: a published pom.xml is immutable on Central and can
         never be edited or withdrawn, unlike SECURITY.md, which is what a
         consumer actually wants for reporting anything. GitHub issues and
         SECURITY.md are the reachable contact points; this entry only needs
         to say who maintains the project. -->
    <developer>
      <id>AindriuB</id>
      <name>Andrew Bannister</name>
      <url>https://github.com/AindriuB</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/AindriuB/data-prism.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/AindriuB/data-prism.git</developerConnection>
    <url>https://github.com/AindriuB/data-prism</url>
  </scm>

  <modules>
    <module>data-prism-annotations</module>
    <module>data-prism-processor</module>
    <module>data-prism-core</module>
    <module>data-prism-pseudonymisation</module>
    <module>data-prism-validation</module>
    <module>data-prism-security</module>
    <module>data-prism-orchestration</module>
    <module>data-prism-mcp</module>
    <module>data-prism-connectors-rest</module>
    <module>data-prism-hazelcast</module>
    <module>data-prism-spring-boot-autoconfigure</module>
    <module>data-prism-spring-boot-starter</module>
    <module>data-prism-server</module>
    <module>data-prism-integration-tests</module>
    <module>data-prism-architecture</module>
    <module>data-prism-quickstart-fixtures</module>
    <module>data-prism-quickstart-issuer</module>
    <module>data-prism-quickstart-extension</module>
  </modules>

  <properties>
    <!-- Artifacts target 21 even when built on a newer JDK, so the library
         stays usable on the version the specification names. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>3.5.16</spring-boot.version>
    <mcp.version>2.0.1</mcp.version>
    <archunit.version>1.5.0</archunit.version>
    <hazelcast.version>5.7.0</hazelcast.version>

    <!-- Maven 3.8.6 still defaults to compiler 3.1, which predates the `release`
         flag, and surefire 2.12.4, which cannot run JUnit 5 at all. Both are
         pinned rather than inherited. -->
    <enforcer.version>3.6.3</enforcer.version>
    <compiler.version>3.16.0</compiler.version>
    <surefire.version>3.6.0</surefire.version>

    <!-- Used only inside the `release` profile below: sources/javadoc jars,
         signing and the Central Portal publishing plugin. Never resolved by
         a plain `mvn verify`. -->
    <source-plugin.version>3.3.1</source-plugin.version>
    <javadoc-plugin.version>3.12.0</javadoc-plugin.version>
    <gpg-plugin.version>3.2.8</gpg-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-bom</artifactId>
        <version>${mcp.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-annotations</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-pseudonymisation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-validation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-orchestration</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-connectors-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-hazelcast</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-server</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-quickstart-fixtures</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-quickstart-issuer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.aindriub</groupId>
        <artifactId>data-prism-quickstart-extension</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce-jackson-major</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- The `mcp` aggregate pulls mcp-json-jackson3, which puts a
                       second Jackson major on the classpath. The scrubbing engine
                       is a Jackson module registered on one ObjectMapper; a split
                       would register it on a mapper that does not serialise MCP
                       output, and would do so silently. Depend on mcp-core plus
                       mcp-json-jackson2 instead. -->
                  <excludes>
                    <exclude>io.modelcontextprotocol.sdk:mcp</exclude>
                    <exclude>io.modelcontextprotocol.sdk:mcp-json-jackson3</exclude>
                    <exclude>tools.jackson.core:*</exclude>
                  </excludes>
                  <message>
                    Do not depend on the `mcp` aggregate or Jackson 3. See
                    docs/architecture.md and the S0 plan: this project is on a
                    single Jackson 2 classpath so the scrubbing module cannot be
                    silently bypassed.
                  </message>
                </bannedDependencies>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Sources/javadoc jars, GPG signing and the Central Portal publishing
           plugin all live here, not in the default build: they need a GPG
           key and slow javadoc generation that a developer's everyday `mvn
           verify` must not require. Activated explicitly with `-Prelease`;
           publish-central.yml is the only caller that does so, and only
           when triggered manually. -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Replaces the classic maven-deploy-plugin/distributionManagement
                 pair: the Central Portal is reached through this plugin alone,
                 configured with the server id whose credentials
                 publish-central.yml supplies from CENTRAL_TOKEN_USERNAME and
                 CENTRAL_TOKEN_PASSWORD. autoPublish stays false so a `deploy`
                 only stages a bundle for the owner to release by hand at
                 central.sonatype.com — this task stops short of the first
                 real publish, see the task's Out of scope. -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
