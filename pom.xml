  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <!-- Used only by the `mutation` profile; declared here so the version
               is pinned in one place. Not bound in the default build. -->
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce-jackson-major</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <!-- Jackson 3 only (J3-5). Jackson 3 lives under tools.jackson; the
                       Jackson 2 databind, core, dataformat and datatype artifacts, the
                       Jackson 2 MCP binding and Spring Boot's Jackson 2 bridge would put
                       a second Jackson major on the classpath, and with it a second
                       mapper family that data-prism's single DataPrismObjectMapper does
                       not govern. jackson-annotations stays: Jackson 3 still reads
                       com.fasterxml.jackson.annotation, and mcp-core needs it. -->
                  <excludes>
                    <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-core</exclude>
                    <exclude>com.fasterxml.jackson.dataformat:*</exclude>
                    <exclude>com.fasterxml.jackson.datatype:*</exclude>
                    <exclude>io.modelcontextprotocol.sdk:mcp-json-jackson2</exclude>
                    <exclude>org.springframework.boot:spring-boot-jackson2</exclude>
                  </excludes>
                  <includes>
                    <include>com.fasterxml.jackson.core:jackson-annotations</include>
                  </includes>
                  <message>
                    Do not depend on Jackson 2 (databind, core, dataformat, datatype),
                    mcp-json-jackson2 or spring-boot-jackson2. This project is on a
                    single Jackson 3 classpath (tools.jackson), so no second mapper
                    family can bypass DataPrismObjectMapper. Only
                    com.fasterxml.jackson.core:jackson-annotations is allowed.
                    See docs/plan/PLAN.md J3-5.
                  </message>
                </bannedDependencies>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Sources/javadoc jars, GPG signing and the Central Portal publishing
           plugin all live here, not in the default build: they need a GPG
           key and slow javadoc generation that a developer's everyday `mvn
           verify` must not require. Activated explicitly with `-Prelease`;
           publish-central.yml is the only caller that does so, and only
           when triggered manually. -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- One CycloneDX JSON SBOM per module, attached with the
                 `cyclonedx` classifier (<artifact>-<version>-cyclonedx.json).
                 Bound to `package`, ahead of the `verify`-phase GPG signing,
                 so the SBOM is signed and bundled for Central like any other
                 attached artifact. -->
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>${cyclonedx-plugin.version}</version>
            <configuration>
              <outputFormat>json</outputFormat>
              <projectType>library</projectType>
            </configuration>
            <executions>
              <execution>
                <id>make-sbom</id>
                <phase>package</phase>
                <goals><goal>makeBom</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Replaces the classic maven-deploy-plugin/distributionManagement
                 pair: the Central Portal is reached through this plugin alone,
                 configured with the server id whose credentials
                 publish-central.yml supplies from CENTRAL_TOKEN_USERNAME and
                 CENTRAL_TOKEN_PASSWORD. autoPublish stays false so a `deploy`
                 only stages a bundle for the owner to release by hand at
                 central.sonatype.com — this task stops short of the first
                 real publish, see the task's Out of scope. -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Mutation testing, report only. Off in the default build; mutation.yml
           and the command in CONTRIBUTING.md activate it with `-Pmutation`.
           PIT writes an HTML and an XML report to target/pit-reports in each
           module that has tests. No mutationThreshold or coverageThreshold is
           set on purpose: this profile measures and never fails a build on a
           score. (The build still fails if the unmutated tests are red.) -->
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest-plugin.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5-plugin.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <outputFormats>
                <outputFormat>HTML</outputFormat>
                <outputFormat>XML</outputFormat>
              </outputFormats>
              <failWhenNoMutations>false</failWhenNoMutations>
              <timestampedReports>false</timestampedReports>
              <threads>4</threads>
            </configuration>
            <executions>
              <execution>
                <id>mutation-coverage</id>
                <phase>verify</phase>
                <goals><goal>mutationCoverage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
