<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.aindriub</groupId>
    <artifactId>data-prism</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>data-prism-connectors-rest</artifactId>
  <name>Data Prism :: Connectors :: REST</name>
  <description>
    HTTP sources over Spring RestClient. A leaf module: nothing in the platform
    depends on it, which is what keeps the MCP layer unable to reach a source
    directly.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.aindriub</groupId>
      <artifactId>data-prism-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The literal here must match STORE_PASSWORD in
               MutualTlsRestClientsHttpsTest, which is also where the value's
               scope is explained: it protects only a throwaway key pair
               generated inside that test run. -->
          <environmentVariables>
            <DATA_PRISM_TEST_TLS_PASSWORD>dp-test-only-not-a-real-secret</DATA_PRISM_TEST_TLS_PASSWORD>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
