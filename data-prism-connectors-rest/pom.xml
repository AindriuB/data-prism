<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.aindriub</groupId>
    <artifactId>data-prism</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>data-prism-connectors-rest</artifactId>
  <name>Data Prism :: Connectors :: REST</name>
  <description>
    HTTP sources over Spring RestClient. Nothing in the base standalone server or
    Spring Boot starter compiles against this module: the configuration-driven
    JSON REST mode it implements is a separately reviewed adapter extension,
    loaded only by an operator who opts in, over the same
    -Dloader.path=&lt;reviewed extension jar&gt; mechanism task 17 built for any
    other reviewed adapter. That is what keeps the MCP layer unable to reach a
    source directly by default.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.aindriub</groupId>
      <artifactId>data-prism-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- ConfiguredJsonScrubbingEngine's own raw-value leak check: see its
         Javadoc for why a configured JSON source needs one the shared
         orchestrator cannot provide for it. -->
    <dependency>
      <groupId>io.github.aindriub</groupId>
      <artifactId>data-prism-validation</artifactId>
    </dependency>
    <!-- ConfiguredJsonSourcesAutoConfiguration assembles a full
         DefaultContextOrchestrator for the sources this module parses, exactly
         as the base distribution's own auto-configuration does for Java-first
         ones: this is what lets a configured source answer through the same
         MCP tool instead of a second, separately-reachable one. -->
    <dependency>
      <groupId>io.github.aindriub</groupId>
      <artifactId>data-prism-orchestration</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The literal here must match STORE_PASSWORD in
               MutualTlsRestClientsHttpsTest, which is also where the value's
               scope is explained: it protects only a throwaway key pair
               generated inside that test run. -->
          <environmentVariables>
            <DATA_PRISM_TEST_TLS_PASSWORD>dp-test-only-not-a-real-secret</DATA_PRISM_TEST_TLS_PASSWORD>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
