<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.aindriub</groupId>
    <artifactId>data-prism</artifactId>
    <version>0.4.0-SNAPSHOT</version>
  </parent>
  <artifactId>data-prism-mcp</artifactId>
  <name>Data Prism :: MCP</name>
  <description>The MCP tool surface. Sees orchestration only, never a connector.</description>
  <dependencies>
    <dependency><groupId>io.github.aindriub</groupId><artifactId>data-prism-orchestration</artifactId></dependency>
    <dependency><groupId>io.github.aindriub</groupId><artifactId>data-prism-security</artifactId></dependency>
    <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-core</artifactId></dependency>
    <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-json-jackson2</artifactId></dependency>
    <!-- Version pinned to match what mcp-core's HttpServletStreamableServerTransportProvider
         is compiled against (its own dependency is `provided`, so it does not
         propagate here); the root POM's imported Spring Boot BOM manages an
         older 6.0.0 that would otherwise win. -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.1.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- Test only: the final AuthorizationService, ScopeResolver and AuditedRefusalException
         cannot otherwise be made to carry an arbitrary code, and the log capture needs a
         logback root logger. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <dataprism.expected-version>${project.version}</dataprism.expected-version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
