# Local Compose quickstart (task 18) - copy this file to .env if you want to
# override any of these, then re-run `docker compose up --build`. Every value
# below has a working default already baked into compose.yaml, so a plain
# `docker compose up --build` with no .env file at all still comes up: this
# file exists to make each fixture-only default visible and named, not to
# require setup before the first run.
#
# None of this is a production secret, and none of it should ever look like
# one. This is a local demonstration only - see docs/quickstart.md.

# The password Docker generates and reuses for the quickstart's own
# throwaway TLS keystore/truststore (docker/certs-init). Change it only if
# you want a fresh certificate; deleting the `certs` volume does the same.
QUICKSTART_CERT_PASSWORD=quickstart-only-not-for-production

# Must agree between the issuer (data-prism-quickstart-issuer) and the
# standalone server's dataprism.security.jwt.issuer / .audience - see
# docker/server/application.yaml. Changing these is safe as long as you
# change both.
QUICKSTART_ISSUER_ID=https://issuer.quickstart.invalid
QUICKSTART_AUDIENCE=data-prism-quickstart-mcp

# The HMAC key the standalone server's pseudonymisation engine derives every
# synthetic value from, named here only because task 17 requires a
# server-controlled deployment to supply one - see
# dataprism.privacy.hmac-key.environment-variable in
# docker/server/application.yaml. A literal secret in dataprism.* YAML is
# refused outright; this is the environment-variable reference that
# refusal exists to require, not an exception to it. It is fixture-only:
# nothing this key protects is real, and a production deployment would name
# an approved secret provider reference here instead of a literal value at
# all.
QUICKSTART_HMAC_KEY=quickstart-demo-hmac-key-not-a-real-secret-32-bytes-long
