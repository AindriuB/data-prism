<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.aindriub</groupId>
    <artifactId>data-prism</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>data-prism-quickstart-fixtures</artifactId>
  <name>Data Prism :: Quickstart :: Fixture APIs</name>
  <description>
    A synthetic HTTP source for the local Compose quickstart (task 18). Every
    record this process can return is invented for this repository; nothing
    resembling a real person belongs here. This is not the platform's business
    domain module — that remains data-prism-example, and out of scope here is
    making data-prism-example itself runnable.
  </description>

  <properties>
    <!-- A runnable quickstart fixture server, not a library artifact: never
         published to Central. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution><goals><goal>repackage</goal></goals></execution>
        </executions>
        <configuration>
          <mainClass>io.github.aindriub.dataprism.quickstart.fixtures.FixturesApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
