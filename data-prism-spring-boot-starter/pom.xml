<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.aindriub</groupId>
    <artifactId>data-prism</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>data-prism-spring-boot-starter</artifactId>
  <name>Data Prism :: Spring Boot starter</name>
  <description>Dependency-only entry point for embedding the protected HTTP MCP endpoint.</description>

  <properties>
    <!-- Sources jar generation is NOT skipped: package-info.java gives this
         module real, non-empty sources content. Javadoc generation IS
         skipped: this package holds only package-info.java (deliberately —
         it is a dependency-only aggregator with no code of its own), and the
         standard javadoc tool hard-errors "No public or protected classes
         found to document" for a package with zero types, regardless of
         visibility flags — confirmed directly against `javadoc` outside
         Maven, not a doclint or plugin-config issue this pom can route
         around. Fixing this needs one real (even trivial) public type added
         to the package; tracked rather than silently worked around, see the
         task 36 hand-off. -->
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.aindriub</groupId>
      <artifactId>data-prism-spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
  </dependencies>
</project>
