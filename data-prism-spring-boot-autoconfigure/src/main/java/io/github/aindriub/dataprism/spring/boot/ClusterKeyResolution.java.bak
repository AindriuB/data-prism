package io.github.aindriub.dataprism.spring.boot;

import io.github.aindriub.dataprism.hazelcast.seal.ClusterKeys;

import java.security.MessageDigest;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Optional;
import java.util.function.Supplier;

/**
 * Resolves the configured cluster and name keys through the reviewed {@link HmacKeyReferenceResolver}, the same way
 * the privacy HMAC key is resolved, and builds the {@link ClusterKeys} a member holds. Shape and presence were
 * checked on the properties before this runs; this checks what only the resolved material can show.
 *
 * <p>Refusals are checked in a fixed order, which {@code docs/configuration.md} lists: key ids that are blank or
 * hold a dot, then each key in turn (current, next, previous, name) for resolution and strength, the privacy HMAC key
 * itself, the cluster keys and then the name key against that key, the same against the audit chain key and its
 * retired keys (when the chain is keyed), a name key equal to a cluster key, then key ids
 * that are not pairwise distinct. A message names a property and never a key id's material, a reference, or anything
 * the resolver said. The resolver's arrays are copied on receipt and only the copies are cleared, as soon as
 * {@link ClusterKeys} has copied them in turn.
 */
final class ClusterKeyResolution {
    private static final String CLUSTER_KEY = HazelcastProperties.Security.CLUSTER_KEY_PROPERTY;
    private static final String NAME_KEY = HazelcastProperties.Security.NAME_KEY_PROPERTY;

    private ClusterKeyResolution() {
    }

    /** One configured key: the property it came from, the code family for its refusals, its id and its source. */
    private record Ref(String property, String area, String keyId, String reference, boolean provider) {
    }

    private static final class Resolved {
        final Ref ref;
        final byte[] material;

        Resolved(Ref ref, byte[] material) {
            this.ref = ref;
            this.material = material;
        }
    }

    /**
     * The resolver is asked for only when a security key is set, so a solo member needs none.
     *
     * @return the keys, or empty when none are configured (only a solo member may have none)
     * @throws DataPrismConfigurationException with the code the register defines for the first failure
     */
    static Optional<ClusterKeys> resolve(DataPrismProperties properties,
                                         Supplier<HmacKeyReferenceResolver> resolverSupplier) {
        HazelcastProperties.Security security = properties.getHazelcast().getSecurity();
        if (!properties.getHazelcast().securitySet()) {
            return Optional.empty();
        }
        HmacKeyReferenceResolver resolver = resolverSupplier.get();
        HazelcastProperties.ClusterKey cluster = security.getClusterKey();
        HazelcastProperties.NameKey name = security.getNameKey();
        List<Resolved> clusterKeys = new ArrayList<>();
        Resolved nameKey = null;
        byte[] hmac = null;
        List<AuditChainKeyResolution.Fingerprint> auditKeys = List.of();
        usableId("CLUSTER_KEY", CLUSTER_KEY, cluster.getKeyId());
        usableId("CLUSTER_KEY", CLUSTER_KEY + ".next", cluster.getNext().getKeyId());
        usableId("CLUSTER_KEY", CLUSTER_KEY + ".previous", cluster.getPrevious().getKeyId());
        usableId("NAME_KEY", NAME_KEY, name.getKeyId());
        try {
            clusterKeys.add(resolve(resolver, ref(CLUSTER_KEY, "CLUSTER_KEY", cluster.getKeyId(),
                    cluster.getEnvironmentVariable(), cluster.getProviderReference())));
            rotation(resolver, clusterKeys, CLUSTER_KEY + ".next", cluster.getNext());
            rotation(resolver, clusterKeys, CLUSTER_KEY + ".previous", cluster.getPrevious());
            nameKey = resolve(resolver, ref(NAME_KEY, "NAME_KEY", name.getKeyId(),
                    name.getEnvironmentVariable(), name.getProviderReference()));

            hmac = privacyKey(properties, resolver);
            for (Resolved key : clusterKeys) {
                shared(key, hmac, properties.getPrivacy().getHmacKey().getKeyId());
            }
            shared(nameKey, hmac, properties.getPrivacy().getHmacKey().getKeyId());
            auditKeys = AuditChainKeyResolution.fingerprints(properties, resolver);
            for (Resolved key : clusterKeys) {
                sharedWithAudit(key, auditKeys);
            }
            sharedWithAudit(nameKey, auditKeys);
            List<LinkFingerprint> linkKeys = linkFingerprints(properties, resolver);
            for (Resolved key : clusterKeys) {
                sharedWithLink(key, linkKeys);
            }
            sharedWithLink(nameKey, linkKeys);
            for (Resolved key : clusterKeys) {
                if (MessageDigest.isEqual(nameKey.material, key.material)) {
                    throw new DataPrismConfigurationException("NAME_KEY_SHARED",
                            NAME_KEY + " must differ from " + key.ref.property());
                }
            }
            distinctIds(clusterKeys, nameKey);

            Resolved current = clusterKeys.get(0);
            Resolved next = find(clusterKeys, CLUSTER_KEY + ".next");
            Resolved previous = find(clusterKeys, CLUSTER_KEY + ".previous");
            return Optional.of(new ClusterKeys(current.ref.keyId(), current.material,
                    next == null ? null : next.ref.keyId(), next == null ? null : next.material,
                    previous == null ? null : previous.ref.keyId(), previous == null ? null : previous.material,
                    nameKey.ref.keyId(), nameKey.material));
        } finally {
            for (Resolved key : clusterKeys) {
                Arrays.fill(key.material, (byte) 0);
            }
            if (nameKey != null) {
                Arrays.fill(nameKey.material, (byte) 0);
            }
            if (hmac != null) {
                Arrays.fill(hmac, (byte) 0);
            }
        }
    }

    /** A key id that is set must be usable: not blank, no dot. Checked per property before anything is resolved. */
    private static void usableId(String area, String property, String keyId) {
        if (keyId != null && (keyId.isBlank() || keyId.indexOf('.') >= 0)) {
            throw new DataPrismConfigurationException(area + "_UNRESOLVED",
                    property + ".key-id must not be blank or contain a dot");
        }
    }

    private static void rotation(HmacKeyReferenceResolver resolver, List<Resolved> out, String property,
                                 HazelcastProperties.RotationKey key) {
        if (key.getKeyId() == null || key.getKeyId().isBlank()) {
            return;
        }
        out.add(resolve(resolver, ref(property, "CLUSTER_KEY", key.getKeyId(),
                key.getEnvironmentVariable(), key.getProviderReference())));
    }

    private static Resolved find(List<Resolved> keys, String property) {
        for (Resolved key : keys) {
            if (key.ref.property().equals(property)) {
                return key;
            }
        }
        return null;
    }

    /** A key reference as configured: where it came from decides which resolver method reads it. */
    private static Ref ref(String property, String area, String keyId, String environmentVariable,
                           String providerReference) {
        boolean environment = environmentVariable != null && !environmentVariable.isBlank();
        return new Ref(property, area, keyId, environment ? environmentVariable : providerReference, !environment);
    }

    private static Resolved resolve(HmacKeyReferenceResolver resolver, Ref ref) {
        byte[] received;
        try {
            received = ref.provider() ? resolver.resolveProviderReference(ref.keyId(), ref.reference())
                    : resolver.resolve(ref.keyId(), ref.reference());
        } catch (DataPrismConfigurationException refused) {
            if ("MISSING_KEY_PROVIDER".equals(refused.code())) {
                // A resolver that cannot serve provider references: the property is named, the reference is not.
                throw new DataPrismConfigurationException("MISSING_KEY_PROVIDER", ref.property()
                        + ".provider-reference needs a resolver that reads provider references, not only "
                        + "environment variables");
            }
            throw new DataPrismConfigurationException(ref.area() + "_UNRESOLVED",
                    ref.property() + " could not be resolved");
        } catch (RuntimeException unresolved) {
            // No cause is kept: a resolver's exception can carry the reference or key material.
            throw new DataPrismConfigurationException(ref.area() + "_UNRESOLVED",
                    ref.property() + " could not be resolved");
        }
        if (received == null) {
            throw new DataPrismConfigurationException(ref.area() + "_UNRESOLVED",
                    ref.property() + " could not be resolved");
        }
        // The resolver does not promise a fresh array (a caching one hands out its own), so this copy is the only
        // one ever cleared.
        byte[] material = received.clone();
        if (material.length < ClusterKeys.MIN_KEY_BYTES) {
            Arrays.fill(material, (byte) 0);
            throw new DataPrismConfigurationException(ref.area() + "_WEAK",
                    ref.property() + " resolves to material shorter than " + ClusterKeys.MIN_KEY_BYTES + " bytes");
        }
        return new Resolved(ref, material);
    }

    /** The privacy HMAC key, already validated before the cluster is built. */
    private static byte[] privacyKey(DataPrismProperties properties, HmacKeyReferenceResolver resolver) {
        PrivacyProperties.HmacKey hmac = properties.getPrivacy().getHmacKey();
        byte[] received;
        try {
            received = HmacKeyReferences.resolve(resolver, hmac, hmac.getKeyId());
        } catch (RuntimeException unresolved) {
            received = null;
        }
        if (received == null) {
            // Without its material the cluster keys cannot be shown to differ from it, so none is accepted.
            throw new DataPrismConfigurationException("HMAC_KEY_UNRESOLVED",
                    "dataprism.privacy.hmac-key could not be resolved to check the cluster keys against it");
        }
        return received.clone();
    }

    private static void shared(Resolved key, byte[] hmac, String hmacKeyId) {
        boolean sameId = key.ref.keyId().equals(hmacKeyId);
        boolean sameMaterial = MessageDigest.isEqual(key.material, hmac);
        if (sameId || sameMaterial) {
            throw new DataPrismConfigurationException(key.ref.area() + "_SHARED",
                    key.ref.property() + " must differ from dataprism.privacy.hmac-key");
        }
    }

    /** The audit chain key (current and retired), by key id and by material, when the chain is keyed. */
    private static void sharedWithAudit(Resolved key, List<AuditChainKeyResolution.Fingerprint> auditKeys) {
        for (AuditChainKeyResolution.Fingerprint audit : auditKeys) {
            if (key.ref.keyId().equals(audit.keyId()) || AuditChainKeyResolution.matches(audit, key.material)) {
                throw new DataPrismConfigurationException(key.ref.area() + "_SHARED",
                        key.ref.property() + " must differ from dataprism.audit.hmac-key and"
                                + " dataprism.audit.retired-hmac-keys");
            }
        }
    }

    /** A link key's id and the SHA-256 of its material: enough to compare against, with nothing to leak. */
    private record LinkFingerprint(String keyId, byte[] sha256) {
    }

    /**
     * The link keys (the current one and any retiring), resolved only to be compared. One that cannot be resolved,
     * or is too short to equal a cluster key, is left out: the link key check refuses it as
     * {@code LINK_KEY_UNRESOLVED} or {@code LINK_KEY_WEAK} where the link keys are built.
     */
    private static List<LinkFingerprint> linkFingerprints(DataPrismProperties properties,
                                                          HmacKeyReferenceResolver resolver) {
        List<LinkFingerprint> out = new ArrayList<>();
        for (Map.Entry<String, LinksProperties.Key> entry : properties.getLinks().getKeys().entrySet()) {
            LinksProperties.Key key = entry.getValue();
            boolean environment = key != null && key.getEnvironmentVariable() != null
                    && !key.getEnvironmentVariable().isBlank();
            boolean provider = key != null && key.getProviderReference() != null
                    && !key.getProviderReference().isBlank();
            if (environment == provider) {
                continue;
            }
            byte[] received;
            try {
                received = HmacKeyReferences.resolve(resolver, !environment, entry.getKey(),
                        environment ? key.getEnvironmentVariable() : key.getProviderReference());
            } catch (RuntimeException unresolved) {
                continue;
            }
            if (received != null && received.length >= ClusterKeys.MIN_KEY_BYTES) {
                out.add(new LinkFingerprint(entry.getKey(), sha256(received)));
            }
        }
        return out;
    }

    private static void sharedWithLink(Resolved key, List<LinkFingerprint> linkKeys) {
        byte[] digest = sha256(key.material);
        for (LinkFingerprint link : linkKeys) {
            if (key.ref.keyId().equals(link.keyId()) || MessageDigest.isEqual(link.sha256(), digest)) {
                throw new DataPrismConfigurationException(key.ref.area() + "_SHARED",
                        key.ref.property() + " must differ from dataprism.links.keys");
            }
        }
    }

    private static byte[] sha256(byte[] material) {
        try {
            return MessageDigest.getInstance("SHA-256").digest(material);
        } catch (java.security.NoSuchAlgorithmException e) {
            throw new IllegalStateException("SHA-256 unavailable", e);
        }
    }

    private static void distinctIds(List<Resolved> clusterKeys, Resolved nameKey) {
        List<Resolved> all = new ArrayList<>(clusterKeys);
        all.add(nameKey);
        for (int i = 0; i < all.size(); i++) {
            for (int j = i + 1; j < all.size(); j++) {
                if (all.get(i).ref.keyId().equals(all.get(j).ref.keyId())) {
                    throw new DataPrismConfigurationException("DUPLICATE_CLUSTER_KEY_ID",
                            all.get(j).ref.property() + ".key-id must differ from " + all.get(i).ref.property()
                                    + ".key-id");
                }
            }
        }
    }
}
