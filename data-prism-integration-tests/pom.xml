<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.aindriub</groupId>
    <artifactId>data-prism</artifactId>
    <version>0.3.1</version>
  </parent>

  <artifactId>data-prism-integration-tests</artifactId>
  <name>Data Prism :: Integration tests</name>
  <description>
    The reactor's cross-module integration test suite: a stub source and a
    runnable server, proving the thread end to end. This is still the only
    module permitted to contain a business domain type, which is what
    ArchitectureTest keys on, and nothing depends on it except
    data-prism-architecture, which depends on every module at test scope
    only, to see the whole graph the boundary rules check.
  </description>

  <properties>
    <!-- The demonstration business-domain module, not a library artifact for
         consumers: never published to Central. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.aindriub</groupId>
      <artifactId>data-prism-spring-boot-starter</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>

    <!-- The resource server dependencies arrive through the Data Prism starter.
         spring-boot-starter-logging is excluded from that dependency so
         logback-classic never reaches this module's classpath — two SLF4J
         providers would let logback's own default console appender win the
         race non-deterministically, and stdio's launcher (ExampleApplication)
         depends on every diagnostic going through slf4j-simple to stderr
         rather than the stream stdio's own protocol occupies. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <!-- Only the Spring Boot dependencies used to exercise the stdio and
         HTTP wiring end to end. The whole-graph architecture rules moved to
         data-prism-architecture, which is the module that depends on every
         other one now. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Task 61: proves task 60's nested-catalogue refusals through the real
         MCP HTTP transport, not just against the engine directly. Test-scoped
         only: the shipped example server never opts into configured JSON
         sources on its own. -->
    <dependency>
      <groupId>io.github.aindriub</groupId>
      <artifactId>data-prism-connectors-rest</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- On the processor path, not the compile classpath: the example
               depends on the check running, not on the checker's classes. -->
          <annotationProcessorPaths>
            <path>
              <groupId>io.github.aindriub</groupId>
              <artifactId>data-prism-processor</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The literal here must match STORE_PASSWORD in
               ConfiguredJsonNestedHttpTest, which generates a throwaway mTLS
               key pair per test run for its own upstream fixture; the same
               precedent is data-prism-connectors-rest's own POM, next to
               MutualTlsRestClientsHttpsTest. -->
          <environmentVariables>
            <TASK61_TLS_PASSWORD>dp-test-only-not-a-real-secret</TASK61_TLS_PASSWORD>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
