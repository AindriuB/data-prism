flowchart TB
    Adapter["DataSourceAdapter implementation\n(e.g. QuickstartCustomerAdapter)"]
    IdResolver["IdentityResolver implementation\n(e.g. MappedIdentityResolver)"]
    AutoConfig["Application @AutoConfiguration\n(e.g. QuickstartExtensionAutoConfiguration)"]
    DataPrismConfig["DataPrismAutoConfiguration:\npreflight refuses startup\nwith neither bean present"]
    Orchestrator["Orchestrator (fan-out):\nfetches each adapter,\nexpand(canonicalId, sourceNames)"]
    Engine["Privacy engine:\nclassification and scrubbing"]

    Adapter -->|"@Bean"| AutoConfig
    IdResolver -->|"@Bean,\n@ConditionalOnMissingBean"| AutoConfig
    AutoConfig -->|"beans visible in\nthe same context"| DataPrismConfig
    DataPrismConfig -->|"injected into\ndataPrismContextOrchestrator"| Orchestrator
    Orchestrator --> Engine
