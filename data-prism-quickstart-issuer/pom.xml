<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.aindriub</groupId>
    <artifactId>data-prism</artifactId>
    <version>0.5.0</version>
  </parent>

  <artifactId>data-prism-quickstart-issuer</artifactId>
  <name>Data Prism :: Quickstart :: Local token issuer</name>
  <description>
    A local JWT issuer for the Compose quickstart (task 18). There is no
    fixture-development bypass for the standalone server (task 21): the
    quickstart issues real, verifiable JWTs against a real JWKS endpoint, and
    this is that endpoint. The signing key is generated in memory at process
    start and never persisted or committed.
  </description>

  <properties>
    <!-- A runnable quickstart token issuer, not a library artifact: never
         published to Central. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <exclusions>
        <!-- Jackson 2 only (D-139-A): the scrubbing module serialises through one Jackson 2 ObjectMapper. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-jackson</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson2</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution><goals><goal>repackage</goal></goals></execution>
        </executions>
        <configuration>
          <mainClass>io.github.aindriub.dataprism.quickstart.issuer.IssuerApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
